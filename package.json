{
  "name": "siege",
  "author": "Luis Gurmendez",
  "version": "1.0.0",
  "description": "MOBA-style game with server-authoritative multiplayer",
  "private": true,
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "serve": "npm-run-all --parallel tsc vite",
    "build": "vite build",
    "lint": "eslint --ext .ts,.js --ignore-path .gitignore src",
    "vite": "vite serve",
    "tsc": "tsc --watch --noEmit",
    "test": "vitest",
    "test:run": "vitest run",
    "test:coverage": "vitest run --coverage",
    "circular": "madge --circular --extensions ts src/*",
    "test:packages": "npm run test --workspaces --if-present"
  },
  "dependencies": {
    "stats.js": "^0.17.0"
  },
  "devDependencies": {
    "@types/stats.js": "^0.17.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "eslint": "^8.57.0",
    "eslint-plugin-unused-imports": "^4.0.0",
    "happy-dom": "^21.0.4",
    "madge": "^8.0.0",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.4.0",
    "vite": "^7.0.0",
    "vitest": "^4.0.17"
  },
  "license": "ISC"
}
