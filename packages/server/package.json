{
  "name": "@siege/server",
  "version": "1.0.0",
  "description": "Siege MOBA game server",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "start": "bun run src/server.ts",
    "start:prod": "bun run dist/server.js",
    "test": "bun test",
    "typecheck": "tsc -b ../shared && tsc -p tsconfig.test.json",
    "sim": "LOG_LEVEL=${LOG_LEVEL:-warn} bun run src/sim/cli.ts",
    "sim:serve": "LOG_LEVEL=${LOG_LEVEL:-warn} bun run src/sim/serve.ts",
    "duels": "LOG_LEVEL=${LOG_LEVEL:-warn} bun run src/sim/duels.ts",
    "games": "LOG_LEVEL=${LOG_LEVEL:-warn} bun run src/sim/games.ts"
  },
  "dependencies": {
    "@siege/shared": "*"
  },
  "devDependencies": {
    "typescript": "^5.3.0",
    "@types/bun": "latest",
    "@types/node": "^20.0.0"
  }
}
